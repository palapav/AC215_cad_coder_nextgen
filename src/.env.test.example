# ============================================
# TEST ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env.test and fill in test credentials
# DO NOT commit .env.test to git (it's in .gitignore)
#
# This file is used for local E2E testing with real services.
# For CI/CD, credentials are passed via GitHub Secrets instead.

# ============================================
# MONGODB CONFIGURATION (Test Database)
# ============================================
# Use a separate test database, not production!
MONGO_URI=mongodb://localhost:27017
MONGO_DB=test_cad_coder

# ============================================
# MODAL LABS CONFIGURATION (Optional for E2E)
# ============================================
# Only needed if you want to test with real Modal inference
# Leave commented out to use mocked backends
# MODAL_TOKEN_ID=your_modal_token_id
# MODAL_TOKEN_SECRET=your_modal_token_secret
# QWEN_MODAL_APP=cad-coder-qwen3
# QWEN_MODAL_FUNCTION=qwen_modal_infer
# LLAVA_MODAL_APP=cad-coder-llava
# LLAVA_MODAL_FUNCTION=llava_modal_infer

# ============================================
# GOOGLE CLOUD STORAGE (Optional for E2E)
# ============================================
# Only needed if testing GCS uploads
# GOOGLE_APPLICATION_CREDENTIALS=path/to/test-service-account.json
# GCS_BUCKET=test-cad-coder-bucket

# ============================================
# RAG CONFIGURATION (Optional for E2E)
# ============================================
# Only needed if testing RAG functionality
# ENABLE_RAG=false
# RAG_PROJECT_ID=your-test-project-id
# RAG_LOCATION=us-central1

# ============================================
# TEST SETTINGS
# ============================================
# Reduced token counts for faster E2E tests
QWEN_MODAL_MAX_NEW_TOKENS=128
LLAVA_MODAL_MAX_NEW_TOKENS=128
QWEN_MODAL_TEMPERATURE=0.0
LLAVA_MODAL_TEMPERATURE=0.0
