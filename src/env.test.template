# Test Environment Configuration Template
# Copy this to .env.test and fill in values for E2E testing with real Modal

# MongoDB (test database)
MONGO_URI=mongodb://mongo-test:27017
MONGO_DB=test_cad_coder

# Modal Authentication (optional - for E2E tests only)
# Leave empty to use mocked backends
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Qwen Model Configuration
# Backend options: "modal" (Modal Labs), "gke" (GKE GPU), "mock" (testing)
QWEN_INFERENCE_BACKEND=mock
QWEN_MODAL_APP=cad-coder-qwen3
QWEN_MODAL_FUNCTION=qwen_modal_infer
QWEN_MODAL_STREAM_FUNCTION=qwen_modal_infer_stream
QWEN_MODAL_MAX_NEW_TOKENS=2048
QWEN_MODAL_TEMPERATURE=0.0

# LLaVA Model Configuration
# Backend options: "modal" (Modal Labs), "gke" (GKE GPU), "mock" (testing)
LLAVA_INFERENCE_BACKEND=mock
LLAVA_MODAL_APP=cad-coder-llava
LLAVA_MODAL_FUNCTION=llava_modal_infer
LLAVA_MODAL_STREAM_FUNCTION=llava_modal_infer_stream
LLAVA_MODAL_MAX_NEW_TOKENS=3450
LLAVA_MODAL_TEMPERATURE=0.0
LLAVA_MODAL_TOP_P=1.0

# RAG Configuration (disabled for tests)
ENABLE_RAG=false
RAG_PROJECT_ID=
RAG_LOCATION=
RAG_INDEX_NAME=
RAG_ENDPOINT_NAME=
RAG_DEPLOYED_INDEX_ID=

